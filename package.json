{
  "name": "mcp-notes-server",
  "version": "1.2.0",
  "description": "MCP server (Model Context Protocol) that gives AI assistants like Claude a searchable notes store: 7 typed tools, JSON file storage, TypeScript.",
  "author": "Saurabh Pathak <saurabhpathak394@gmail.com> (https://github.com/techsaurabh-394)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-notes-server": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "coverage": "npm run build && node --test --experimental-test-coverage dist/test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "ai-agents",
    "ai-memory",
    "llm-tools",
    "notes",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techsaurabh-394/mcp-notes-server.git"
  },
  "bugs": {
    "url": "https://github.com/techsaurabh-394/mcp-notes-server/issues"
  },
  "homepage": "https://github.com/techsaurabh-394/mcp-notes-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "mcp-safe-actions": "github:techsaurabh-394/mcp-safe-actions"
  },
  "funding": {
    "type": "individual",
    "url": "https://buymeacoffee.com/saurabhdev"
  }
}
