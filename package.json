{
  "name": "mcp-notes-server",
  "version": "1.1.0",
  "description": "A small Model Context Protocol (MCP) server that gives AI assistants a searchable notes store.",
  "author": "Saurabh Pathak <saurabhpathak394@gmail.com> (https://github.com/techsaurabh-394)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-notes-server": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/test"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai-agents",
    "notes",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techsaurabh-394/mcp-notes-server.git"
  },
  "bugs": {
    "url": "https://github.com/techsaurabh-394/mcp-notes-server/issues"
  },
  "homepage": "https://github.com/techsaurabh-394/mcp-notes-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
